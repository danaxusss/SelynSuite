# ─────────────────────────────────────────────────────────────────────────
# Selyn Suite — environment variables (template)
# Copy to `.env` for local dev. NEVER commit `.env`.
# Production values live on the host (Hostinger) — see README §Deployment.
# ─────────────────────────────────────────────────────────────────────────

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug                       # error | warn | info | debug | trace
TZ=Africa/Casablanca

# ── Web (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Selyn
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# ── API (NestJS) ───────────────────────────────────────────────────────────
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001

# ── Database (PostgreSQL 16) ───────────────────────────────────────────────
DATABASE_URL=postgresql://selyn:selyn_dev_password@localhost:5432/selyn_dev?schema=public
DATABASE_POOL_MAX=10

# ── Cache & queues (Redis 7 + BullMQ) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=selyn:dev:

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# 2FA / TOTP issuer label shown in authenticator apps
AUTH_TOTP_ISSUER=Selyn

# ── S3-compatible storage (Moroccan provider preferred) ────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=selyn-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Email (transactional) ──────────────────────────────────────────────────
# Local dev uses MailHog (smtp://localhost:1025). Production: Resend or Postmark.
EMAIL_PROVIDER=smtp                   # smtp | resend | postmark
EMAIL_FROM=no-reply@selyn.qodweb.com
EMAIL_FROM_NAME=Selyn
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Moroccan integrations (Phase 6+) ───────────────────────────────────────
DAMANCOM_AFFILIATION_NUMBER=
DAMANCOM_TEST_MODE=true

# ── Internal admin (Selyn staff only) ──────────────────────────────────────
SELYN_INTERNAL_ADMIN_EMAILS=          # comma-separated allow-list

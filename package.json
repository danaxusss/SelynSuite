{
  "name": "selyn-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Selyn Suite — Moroccan SaaS for SMEs. SelynPaie is the first product.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "prisma:generate": "pnpm --filter @selyn/api exec prisma generate",
    "prisma:migrate": "pnpm --filter @selyn/api exec prisma migrate dev",
    "prisma:studio": "pnpm --filter @selyn/api exec prisma studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.1"
  }
}
